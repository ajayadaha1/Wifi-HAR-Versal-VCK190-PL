	hex "size"
	default 0x0
	depends on SUBSYSTEM_FLASH_QSPI_PART7_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART7_FLAGS
	string "flash partition flags"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART7_NAME != "" && SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	help
	Pass the flash partition flags to DTS. Use comma separatioon for
