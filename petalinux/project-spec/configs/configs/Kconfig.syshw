	Currently, the supported string is RO ("read-only" string) flag
	which marks the partition read-only

comment "partition 8"
	depends on SUBSYSTEM_FLASH_QSPI_PART7_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART8_NAME
	string "name"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART7_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART8_SIZE
	hex "size"
	default 0x0
	depends on SUBSYSTEM_FLASH_QSPI_PART8_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART8_FLAGS
	string "flash partition flags"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART8_NAME != "" && SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	help
	Pass the flash partition flags to DTS. Use comma separatioon for
	multiple flags, e.g. abc,def,...,xyz
	Currently, the supported string is RO ("read-only" string) flag
	which marks the partition read-only

comment "partition 9"
	depends on SUBSYSTEM_FLASH_QSPI_PART8_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART9_NAME
	string "name"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART8_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART9_SIZE
	hex "size"
	default 0x0
	depends on SUBSYSTEM_FLASH_QSPI_PART9_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART9_FLAGS
	string "flash partition flags"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART9_NAME != "" && SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	help
	Pass the flash partition flags to DTS. Use comma separatioon for
	multiple flags, e.g. abc,def,...,xyz
	Currently, the supported string is RO ("read-only" string) flag
	which marks the partition read-only

