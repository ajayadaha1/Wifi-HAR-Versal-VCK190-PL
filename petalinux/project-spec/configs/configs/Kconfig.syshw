menu "Subsystem Hardware Settings"

config SUBSYSTEM_PROCESSOR0_IP_NAME
	string
	default psv_cortexa72_0

config SUBSYSTEM_ENABLE_ARCH64
	bool
	default y
	select SUBSYSTEM_ARCH_AARCH64
	depends on SUBSYSTEM_PROCESSOR_psv_cortexa72_0_SELECT

choice
	prompt "System Processor"
	help
	Select a processor as the system processor.

config SUBSYSTEM_PROCESSOR_psv_cortexa72_0_SELECT
	bool "psv_cortexa72_0"

endchoice

if SUBSYSTEM_PROCESSOR_psv_cortexa72_0_SELECT

menu "Memory Settings"
choice
	prompt "Primary Memory"
	default SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_0_SELECT

	help
	The configuration in this menu impacts the
	memory settings in the device tree autoconfig files.
	If you select "manual",
	Auto generate the memory node based on user inputs,
	you will need to specify base address and memory size.
	To skip generating lower or upper memory node specify 0x0 offset to the memory size.

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_0_SELECT
	bool "axi_noc_DDR_LOW_0"

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_1_SELECT
	bool "axi_noc_DDR_LOW_1"

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_CH_1_SELECT
	bool "axi_noc_DDR_CH_1"

config SUBSYSTEM_MEMORY_MANUAL_SELECT
	bool "manual"

endchoice

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_0_BASEADDR
	hex "System memory base address"
	default 0x0
	range 0x0 0x7e000000
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_0_SELECT
	help
	Start address of the system memory.
	It has to be within the selected primary memory physical address range.
	Make sure the DT memory entry should start with provided address.

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_0_SIZE
	hex "System memory size"
	default 0x80000001
	range 0x2000000 0x80000001
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_0_SELECT
	help
	Size of the system memory. Minimum is 32MB, maximum is the size of
	the selected primary memory physical address range.

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_0_U__BOOT_TEXTBASE_OFFSET
	hex "u-boot text base address"
	default 0x40000000 if SYSTEM_VERSAL-2VE-2VM
	default 0x8000000 if SUBSYSTEM_ARCH_AARCH64
	default 0x4000000 if SUBSYSTEM_ARCH_ARM
	default 0x100000 if SUBSYSTEM_ARCH_MICROBLAZE
	range 0x100000 0x7e100000
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_0_SELECT
	depends on !SUBSYSTEM_COMPONENT_U__BOOT_NAME_NONE
	help
	u-boot text base address by specifying from the memory base address.
	u-boot load address = bank base address + offset. And same value will
	pass to TF-A also. Minimum suggested is 1MB.

config SUBSYSTEM_MEMORY_IP_NAME
	string
	default axi_noc_DDR_LOW_0
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_0_SELECT

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_1_BASEADDR
	hex "System memory base address"
	default 0x800000000
	range 0x800000000 0x97e000000
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_1_SELECT
	help
	Start address of the system memory.
	It has to be within the selected primary memory physical address range.
	Make sure the DT memory entry should start with provided address.

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_1_SIZE
	hex "System memory size"
	default 0x180000001
	range 0x2000000 0x180000001
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_1_SELECT
	help
	Size of the system memory. Minimum is 32MB, maximum is the size of
	the selected primary memory physical address range.

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_1_U__BOOT_TEXTBASE_OFFSET
	hex "u-boot text base address"
	default 0x840000000 if SYSTEM_VERSAL-2VE-2VM
	default 0x808000000 if SUBSYSTEM_ARCH_AARCH64
	default 0x804000000 if SUBSYSTEM_ARCH_ARM
	default 0x800100000 if SUBSYSTEM_ARCH_MICROBLAZE
	range 0x800100000 0x117e100000
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_1_SELECT
	depends on !SUBSYSTEM_COMPONENT_U__BOOT_NAME_NONE
	help
	u-boot text base address by specifying from the memory base address.
	u-boot load address = bank base address + offset. And same value will
	pass to TF-A also. Minimum suggested is 1MB.

config SUBSYSTEM_MEMORY_IP_NAME
	string
	default axi_noc_DDR_LOW_1
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_LOW_1_SELECT

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_CH_1_BASEADDR
	hex "System memory base address"
	default 0x50000000000
	range 0x50000000000 0x501fe000000
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_CH_1_SELECT
	help
	Start address of the system memory.
	It has to be within the selected primary memory physical address range.
	Make sure the DT memory entry should start with provided address.

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_CH_1_SIZE
	hex "System memory size"
	default 0x200000001
	range 0x2000000 0x200000001
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_CH_1_SELECT
	help
	Size of the system memory. Minimum is 32MB, maximum is the size of
	the selected primary memory physical address range.

config SUBSYSTEM_MEMORY_AXI_NOC_DDR_CH_1_U__BOOT_TEXTBASE_OFFSET
	hex "u-boot text base address"
	default 0x50040000000 if SYSTEM_VERSAL-2VE-2VM
	default 0x50008000000 if SUBSYSTEM_ARCH_AARCH64
	default 0x50004000000 if SUBSYSTEM_ARCH_ARM
	default 0x50000100000 if SUBSYSTEM_ARCH_MICROBLAZE
	range 0x50000100000 0xa01fe100000
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_CH_1_SELECT
	depends on !SUBSYSTEM_COMPONENT_U__BOOT_NAME_NONE
	help
	u-boot text base address by specifying from the memory base address.
	u-boot load address = bank base address + offset. And same value will
	pass to TF-A also. Minimum suggested is 1MB.

config SUBSYSTEM_MEMORY_IP_NAME
	string
	default axi_noc_DDR_CH_1
	depends on SUBSYSTEM_MEMORY_AXI_NOC_DDR_CH_1_SELECT

config SUBSYSTEM_MEMORY_MANUAL_LOWER_BASEADDR
	hex "Lower memory base address"
	default 0x0
	depends on SUBSYSTEM_MEMORY_MANUAL_SELECT
	help
	base address of the lower memory
	Make sure the DT memory entry should start with provided address.

config SUBSYSTEM_MEMORY_MANUAL_LOWER_MEMORYSIZE
	hex "Lower memory size"
	default 0x80000000
	depends on SUBSYSTEM_MEMORY_MANUAL_SELECT
	help
	Size of the lower memory. Minimum is 32MB, maximum is the size of
	the selected primary memory physical address range.
	If you specify 0x0 offset then it will skip generating lower memory node.

config SUBSYSTEM_MEMORY_MANUAL_UPPER_BASEADDR
	hex "Upper memory base address"
	default 0x800000000
	depends on SUBSYSTEM_MEMORY_MANUAL_SELECT
	depends on SUBSYSTEM_ARCH_AARCH64
	help
	base address of the upper memory
	Make sure the DT memory entry should start with provided address.

config SUBSYSTEM_MEMORY_MANUAL_UPPER_MEMORYSIZE
	hex "Upper memory size"
	default 0x80000000
	depends on SUBSYSTEM_MEMORY_MANUAL_SELECT
	depends on SUBSYSTEM_ARCH_AARCH64
	help
	Size of the lower memory. Minimum is 32MB, maximum is the size of
	the selected primary memory physical address range.
	If you specify 0x0 offset then it will skip generating lower memory node.

endmenu

menu "Serial Settings"

choice
	prompt "PLM Serial stdin/stdout"
	help
	Select a serial as the PLM's stdin,stdout.
	If you select 'manual', you will need to add this variable
	For XSCT flow:
	 YAML_SERIAL_CONSOLE_STDIN:forcevariable:pn-<recipename> = "<serial_ipname>"
	 YAML_SERIAL_CONSOLE_STDOUT:forcevariable:pn-<recipename> = "<serial_ipname>"
	 in petalinuxbsp.conf file or local.conf to specify the stdin/stdout."

config SUBSYSTEM_PLM_SERIAL_SERIAL0_SELECT
	bool "serial0"

config SUBSYSTEM_PLM_SERIAL_MANUAL_SELECT
	bool "manual"

endchoice

choice
	prompt "TF-A Serial stdin/stdout"
	help
	Select a serial as the TF-A's stdin,stdout.
	If you select 'manual', you will need to add this variable
	TFA_CONSOLE:forcevariable = "<serial_ipname>" in petalinuxbps.conf or local.conf

config SUBSYSTEM_TF-A_SERIAL_SERIAL0_SELECT
	bool "serial0"

config SUBSYSTEM_TF-A_SERIAL_MANUAL_SELECT
	bool "manual"

endchoice

choice
	prompt "U-boot/Linux Serial stdin/stdout"
	help
	Select a serial as the U-boot and Linux's stdin,stdout.
	If you select 'manual', you will need to add this variable
	For XSCT flow:
	 YAML_SERIAL_CONSOLE_STDIN:forcevariable:pn-<recipename> = "<serial_ipname>"
	 YAML_SERIAL_CONSOLE_STDOUT:forcevariable:pn-<recipename> = "<serial_ipname>"
	 in petalinuxbsp.conf file or local.conf to specify the stdin/stdout."

config SUBSYSTEM_SERIAL_SERIAL0_SELECT
	bool "serial0"

config SUBSYSTEM_SERIAL_MANUAL_SELECT
	bool "manual"

endchoice

choice
	prompt "System stdin/stdout baudrate for serial0"
	default SUBSYSTEM_SERIAL_SERIAL0_BAUDRATE_115200
	help
	Baudrate settings for serial Ip serial0
	The Baudrate setting applies only for U-boot/Linux serial Ip

config SUBSYSTEM_SERIAL_SERIAL0_BAUDRATE_600
	bool "600"

config SUBSYSTEM_SERIAL_SERIAL0_BAUDRATE_9600
	bool "9600"

config SUBSYSTEM_SERIAL_SERIAL0_BAUDRATE_28800
	bool "28800"

config SUBSYSTEM_SERIAL_SERIAL0_BAUDRATE_115200
	bool "115200"

config SUBSYSTEM_SERIAL_SERIAL0_BAUDRATE_230400
	bool "230400"

config SUBSYSTEM_SERIAL_SERIAL0_BAUDRATE_460800
	bool "460800"

config SUBSYSTEM_SERIAL_SERIAL0_BAUDRATE_921600
	bool "921600"

endchoice

config SUBSYSTEM_SERIAL_PLM_IP_NAME
	string
	default serial0 if SUBSYSTEM_PLM_SERIAL_SERIAL0_SELECT

config SUBSYSTEM_SERIAL_TF-A_IP_NAME
	string
	default pl011 if SUBSYSTEM_TF-A_SERIAL_SERIAL0_SELECT

config SUBSYSTEM_SERIAL_IP_NAME
	string
	default serial0 if SUBSYSTEM_SERIAL_SERIAL0_SELECT

endmenu

menu "Ethernet Settings"

choice
	prompt "Primary Ethernet"
	help
	Select a Ethernet used as primary Ethernet.
	The primary ethernet will be used for u-boot networking if u-boot is
	selected and will be used as eth0 in Linux.
	If your preferred primary ethernet is not on the list, please select"
	'manual'.

config SUBSYSTEM_ETHERNET_GEM0_SELECT
	bool "gem0"

config SUBSYSTEM_ETHERNET_GEM1_SELECT
	bool "gem1"

config SUBSYSTEM_ETHERNET_MANUAL_SELECT
	bool "manual"

endchoice

config SUBSYSTEM_ETHERNET_GEM0_MAC_AUTO
	bool "Randomise MAC address"
	default y if SUBSYSTEM_ARCH_MICROBLAZE
	default n
	depends on SUBSYSTEM_ETHERNET_GEM0_SELECT
	help
	randomise MAC address for the primary ethernet.

config SUBSYSTEM_ETHERNET_GEM0_MAC_PATTERN
	string "Template for randomised MAC address"
	default "00:0a:35:00:??:??"
	depends on SUBSYSTEM_ETHERNET_GEM0_SELECT && SUBSYSTEM_ETHERNET_GEM0_MAC_AUTO
	help
	Pattern for generating random MAC addresses - question mark
	characters will be replaced by random hex digits

config SUBSYSTEM_ETHERNET_GEM0_MAC
	string "Ethernet MAC address"
	depends on SUBSYSTEM_ETHERNET_GEM0_SELECT && !SUBSYSTEM_ETHERNET_GEM0_MAC_AUTO
	help
	Default mac address will set from eeprom fru data
	if you want change with desired value you can change, example: 00:0a:35:00:22:01 or ff:ff:ff:ff:ff:ff

config SUBSYSTEM_ETHERNET_GEM0_USE_DHCP
	bool "Obtain IP address automatically"
	default y
	depends on SUBSYSTEM_ETHERNET_GEM0_SELECT
	help
	Set this option if you would like your SUBSYSTEM to use DHCP for
	obtaining an IP address.

config SUBSYSTEM_ETHERNET_GEM0_IP_ADDRESS
	string "Static IP address"
	default "192.168.0.10"
	depends on SUBSYSTEM_ETHERNET_GEM0_SELECT && !SUBSYSTEM_ETHERNET_GEM0_USE_DHCP
	help
	The IP address of your main network interface when static network
	address assignment is used.

config SUBSYSTEM_ETHERNET_GEM0_IP_NETMASK
	string "Static IP netmask"
	default "255.255.255.0"
	depends on SUBSYSTEM_ETHERNET_GEM0_SELECT && !SUBSYSTEM_ETHERNET_GEM0_USE_DHCP
	help
	Default netmask when static network address assignment is used.
	In case of systemd please specify netmask value like CIDR notation Eg: 24 instead of 255.255.255.0
	In case of sysvinit please specify netmask value like dot-decimal notation Eg: 255.255.255.0 instead of 24

config SUBSYSTEM_ETHERNET_GEM0_IP_GATEWAY
	string "Static IP gateway"
	default "192.168.0.1"
	depends on SUBSYSTEM_ETHERNET_GEM0_SELECT && !SUBSYSTEM_ETHERNET_GEM0_USE_DHCP
	help
	Default gateway when static network address assignment is used.

config SUBSYSTEM_ETHERNET_GEM1_MAC_AUTO
	bool "Randomise MAC address"
	default y if SUBSYSTEM_ARCH_MICROBLAZE
	default n
	depends on SUBSYSTEM_ETHERNET_GEM1_SELECT
	help
	randomise MAC address for the primary ethernet.

config SUBSYSTEM_ETHERNET_GEM1_MAC_PATTERN
	string "Template for randomised MAC address"
	default "00:0a:35:00:??:??"
	depends on SUBSYSTEM_ETHERNET_GEM1_SELECT && SUBSYSTEM_ETHERNET_GEM1_MAC_AUTO
	help
	Pattern for generating random MAC addresses - question mark
	characters will be replaced by random hex digits

config SUBSYSTEM_ETHERNET_GEM1_MAC
	string "Ethernet MAC address"
	depends on SUBSYSTEM_ETHERNET_GEM1_SELECT && !SUBSYSTEM_ETHERNET_GEM1_MAC_AUTO
	help
	Default mac address will set from eeprom fru data
	if you want change with desired value you can change, example: 00:0a:35:00:22:01 or ff:ff:ff:ff:ff:ff

config SUBSYSTEM_ETHERNET_GEM1_USE_DHCP
	bool "Obtain IP address automatically"
	default y
	depends on SUBSYSTEM_ETHERNET_GEM1_SELECT
	help
	Set this option if you would like your SUBSYSTEM to use DHCP for
	obtaining an IP address.

config SUBSYSTEM_ETHERNET_GEM1_IP_ADDRESS
	string "Static IP address"
	default "192.168.0.10"
	depends on SUBSYSTEM_ETHERNET_GEM1_SELECT && !SUBSYSTEM_ETHERNET_GEM1_USE_DHCP
	help
	The IP address of your main network interface when static network
	address assignment is used.

config SUBSYSTEM_ETHERNET_GEM1_IP_NETMASK
	string "Static IP netmask"
	default "255.255.255.0"
	depends on SUBSYSTEM_ETHERNET_GEM1_SELECT && !SUBSYSTEM_ETHERNET_GEM1_USE_DHCP
	help
	Default netmask when static network address assignment is used.
	In case of systemd please specify netmask value like CIDR notation Eg: 24 instead of 255.255.255.0
	In case of sysvinit please specify netmask value like dot-decimal notation Eg: 255.255.255.0 instead of 24

config SUBSYSTEM_ETHERNET_GEM1_IP_GATEWAY
	string "Static IP gateway"
	default "192.168.0.1"
	depends on SUBSYSTEM_ETHERNET_GEM1_SELECT && !SUBSYSTEM_ETHERNET_GEM1_USE_DHCP
	help
	Default gateway when static network address assignment is used.

endmenu

menu "Flash Settings"

choice
	prompt "Primary Flash"
	help
	Select a Flash instance used as Primary Flash.
	Auto config will apply the flash partition table settings
	to the primary flash.
	If you preferred flash is not on the list or you don't want
	to manage your flash partition, please select manual.

config SUBSYSTEM_FLASH_QSPI_SELECT
	bool "qspi"

config SUBSYSTEM_FLASH_MANUAL_SELECT
	bool "manual"

endchoice

config SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	bool "Advanced Flash Auto Configuration"
	default n
	depends on !SUBSYSTEM_FLASH_MANUAL_SELECT
	help

comment "partition 0"
	depends on SUBSYSTEM_FLASH_QSPI_SELECT

config SUBSYSTEM_FLASH_QSPI_PART0_NAME
	string "name"
	default "qspi-boot"
	depends on SUBSYSTEM_FLASH_QSPI_SELECT

config SUBSYSTEM_FLASH_QSPI_PART0_SIZE
	hex "size"
	default 0x100000
	depends on SUBSYSTEM_FLASH_QSPI_PART0_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART0_FLAGS
	string "flash partition flags"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART0_NAME != "" && SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	help
	Pass the flash partition flags to DTS. Use comma separatioon for
	multiple flags, e.g. abc,def,...,xyz
	Currently, the supported string is RO ("read-only" string) flag
	which marks the partition read-only

comment "partition 1"
	depends on SUBSYSTEM_FLASH_QSPI_PART0_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART1_NAME
	string "name"
	default "qspi-kernel"
	depends on SUBSYSTEM_FLASH_QSPI_PART0_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART1_SIZE
	hex "size"
	default 0x1600000
	depends on SUBSYSTEM_FLASH_QSPI_PART1_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART1_FLAGS
	string "flash partition flags"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART1_NAME != "" && SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	help
	Pass the flash partition flags to DTS. Use comma separatioon for
	multiple flags, e.g. abc,def,...,xyz
	Currently, the supported string is RO ("read-only" string) flag
	which marks the partition read-only

comment "partition 2"
	depends on SUBSYSTEM_FLASH_QSPI_PART1_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART2_NAME
	string "name"
	default "qspi-bootenv"
	depends on SUBSYSTEM_FLASH_QSPI_PART1_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART2_SIZE
	hex "size"
	default 0x40000
	depends on SUBSYSTEM_FLASH_QSPI_PART2_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART2_FLAGS
	string "flash partition flags"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART2_NAME != "" && SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	help
	Pass the flash partition flags to DTS. Use comma separatioon for
	multiple flags, e.g. abc,def,...,xyz
	Currently, the supported string is RO ("read-only" string) flag
	which marks the partition read-only

comment "partition 3"
	depends on SUBSYSTEM_FLASH_QSPI_PART2_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART3_NAME
	string "name"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART2_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART3_SIZE
	hex "size"
	default 0x0
	depends on SUBSYSTEM_FLASH_QSPI_PART3_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART3_FLAGS
	string "flash partition flags"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART3_NAME != "" && SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	help
	Pass the flash partition flags to DTS. Use comma separatioon for
	multiple flags, e.g. abc,def,...,xyz
	Currently, the supported string is RO ("read-only" string) flag
	which marks the partition read-only

comment "partition 4"
	depends on SUBSYSTEM_FLASH_QSPI_PART3_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART4_NAME
	string "name"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART3_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART4_SIZE
	hex "size"
	default 0x0
	depends on SUBSYSTEM_FLASH_QSPI_PART4_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART4_FLAGS
	string "flash partition flags"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART4_NAME != "" && SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	help
	Pass the flash partition flags to DTS. Use comma separatioon for
	multiple flags, e.g. abc,def,...,xyz
	Currently, the supported string is RO ("read-only" string) flag
	which marks the partition read-only

comment "partition 5"
	depends on SUBSYSTEM_FLASH_QSPI_PART4_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART5_NAME
	string "name"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART4_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART5_SIZE
	hex "size"
	default 0x0
	depends on SUBSYSTEM_FLASH_QSPI_PART5_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART5_FLAGS
	string "flash partition flags"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART5_NAME != "" && SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	help
	Pass the flash partition flags to DTS. Use comma separatioon for
	multiple flags, e.g. abc,def,...,xyz
	Currently, the supported string is RO ("read-only" string) flag
	which marks the partition read-only

comment "partition 6"
	depends on SUBSYSTEM_FLASH_QSPI_PART5_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART6_NAME
	string "name"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART5_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART6_SIZE
	hex "size"
	default 0x0
	depends on SUBSYSTEM_FLASH_QSPI_PART6_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART6_FLAGS
	string "flash partition flags"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART6_NAME != "" && SUBSYSTEM_FLASH__ADVANCED_AUTOCONFIG
	help
	Pass the flash partition flags to DTS. Use comma separatioon for
	multiple flags, e.g. abc,def,...,xyz
	Currently, the supported string is RO ("read-only" string) flag
	which marks the partition read-only

comment "partition 7"
	depends on SUBSYSTEM_FLASH_QSPI_PART6_NAME != ""

config SUBSYSTEM_FLASH_QSPI_PART7_NAME
	string "name"
	default ""
	depends on SUBSYSTEM_FLASH_QSPI_PART6_NAME != ""

